# Slack (see README: "Create the Slack app")
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLASH_COMMAND=/bot

# Which modules to load: * for all, or a comma separated list like specs
ENABLED_MODULES=*
LOG_LEVEL=INFO

# Dell TechDirect API, optional: adds ship date and warranty to Dell lookups
DELL_CLIENT_ID=
DELL_CLIENT_SECRET=
# Without keys, Dell lookups run through a hidden Chromium inside the bot
# container (needs about 1 GB of free RAM). Set to off to disable it.
DELL_BROWSER=auto

# Where a pasted Dell export (DM the bot the CSV) is also posted: a channel ID
# (C0123...) or #name. Blank = only answer in the DM.
INTAKE_CHANNEL=

# Chat: @sr-bot anything that isn't a command and a local model answers.
# Any OpenAI-compatible server works: Ollama (http://<host>:11434/v1), LM Studio,
# llama.cpp server, vLLM. Blank URL = chat off (unknown messages show help).
LLM_BASE_URL=
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_SYSTEM_PROMPT=You are sr-bot, the IT team's Slack assistant. Answer briefly and plainly.

# Admin web page (http://<lxc ip>:8080). Username is anything, password is this.
ADMIN_PASSWORD=
ADMIN_PORT=8080
# Check GitHub for new commits this often and apply them. 0 turns it off.
ADMIN_AUTO_UPDATE_MINUTES=30
